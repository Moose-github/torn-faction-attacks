{
  "name": "stock-market-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy": "wrangler d1 migrations apply STOCK_DB --remote --config wrangler.jsonc && wrangler deploy --config wrangler.jsonc",
    "dev": "wrangler dev --config wrangler.jsonc",
    "types": "wrangler types --config wrangler.jsonc"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
