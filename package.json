{
	"name": "torn-faction-attacks",
	"description": "Cloudflare Worker and React dashboard that track Torn faction attacks, wars and member stats.",
	"devDependencies": {
		"typescript": "5.9.3",
		"vitest": "^4.1.7",
		"wrangler": "4.56.0"
	},
	"private": true,
	"scripts": {
		"cf-typegen": "wrangler types",
		"check": "npm run check:worker && npm run check:stock-worker && npm run check:enemy-hospital-monitor && npm run check:dashboard",
		"check:all": "npm run schema:check && npm run test && npm run check",
		"check:dashboard": "npm --prefix dashboard run build",
		"check:enemy-hospital-monitor": "npm --prefix workers/enemy-hospital-monitor run check",
		"check:stock-worker": "npm --prefix workers/stock-market run check",
		"check:worker": "tsc && wrangler deploy --dry-run",
		"discord:commands:global": "node scripts/register-discord-commands.mjs --global",
		"discord:commands:guild": "node scripts/register-discord-commands.mjs --guild",
		"deploy": "npm run migrate:remote && wrangler deploy",
		"deploy:all": "npm run deploy && npm run deploy:stock-worker && npm run deploy:enemy-hospital-monitor",
		"deploy:enemy-hospital-monitor": "npm --prefix workers/enemy-hospital-monitor run deploy",
		"deploy:stock-worker": "npm --prefix workers/stock-market run deploy",
		"dev": "npm run seedLocalD1 && wrangler dev",
		"migrate:local": "wrangler d1 migrations apply DB --local",
		"migrate:remote": "wrangler d1 migrations apply DB --remote",
		"schema:check": "node scripts/schema-tools.mjs --strict",
		"seedLocalD1": "wrangler d1 migrations apply DB --local",
		"test": "vitest run"
	},
	"dependencies": {
		"@resvg/resvg-wasm": "^2.6.2",
		"dejavu-fonts-ttf": "^2.37.3"
	}
}
